# Security headers for every response. scripts/build.mjs replaces the hash placeholder
# in script-src with the sha256 of each inline <script>, so no other inline script can run.
# cloudflareinsights.com is Cloudflare Web Analytics, which Cloudflare injects while it's on in the dashboard.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __SCRIPT_HASHES__ https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# The resume: browsers show PDFs in their own viewer, so the page CSP doesn't apply and could block it.
/Sushant_Nagil_Resume.pdf
  ! Content-Security-Policy
  Content-Disposition: inline; filename="Sushant_Nagil_Resume.pdf"
